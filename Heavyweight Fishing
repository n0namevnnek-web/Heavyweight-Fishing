-- Fluent Ban Wave Notification Script
-- Shows a notification when the script loads.
-- Uses FluentUI if available, with a fallback to Roblox's built-in notification.

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local guiService = game:GetService("StarterGui")

-- ===== Load FluentUI (if not already loaded) =====
local Fluent
if _G.Fluent then
    Fluent = _G.Fluent
else
    -- Attempt to load Fluent from the official GitHub release
    local success, result = pcall(function()
        return loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
    end)
    if success and result then
        Fluent = result
        _G.Fluent = Fluent  -- cache for future use
    else
        warn("FluentUI not loaded. Using fallback notification.")
    end
end

-- ===== Notification function =====
local function showNotification()
    local title = "⚠️ Important Notice"
    local message = [[Script is currently not working due to a ban wave.
Please join our Discord for more information:
https://discord.gg/5JJAuHRUgJ]]
    local duration = 10  -- seconds

    if Fluent and Fluent:Notify then
        -- FluentUI notification
        Fluent:Notify({
            Title = title,
            Content = message,
            Duration = duration,
        })
    else
        -- Fallback to Roblox's built-in notification
        guiService:SetCore("SendNotification", {
            Title = title,
            Text = message:gsub("\n", " "),  -- remove line breaks for core notification
            Duration = duration,
        })
    end
end

-- ===== Show the notification when the script loads =====
-- Wait a short moment to ensure UI is ready
task.wait(0.5)
showNotification()

-- Optionally, you can also display it again after a delay if needed,
-- but once is enough.
