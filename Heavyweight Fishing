--[[
    NNVN HUB - Ophyn UI Source for Jnkie

    Upload this file to the UI-Source field in your Jnkie Lua Script.
    Upload the actual NNVN HUB main script to the Original Code field.
]]

local JNKIE_SCRIPT_DOWNLOAD_URL = "https://api.jnkie.com/api/v1/luascripts/public/65715a02f02d2e485e6f03b072080e1b68760de84457d777ae4d2405fda583d4/download"

local function compileSource(source, chunkName)
    local chunk, compileError = loadstring(source, chunkName)
    if not chunk then
        warn("[NNVN HUB] Compile error: " .. tostring(compileError))
        return nil
    end
    return chunk
end

local function loadProtectedMainScript(key)
    if type(key) ~= "string" or key == "" then
        warn("[NNVN HUB] Jnkie did not return a valid key.")
        return
    end

    getgenv().SCRIPT_KEY = key

    local downloaded, source = pcall(function()
        return game:HttpGet(JNKIE_SCRIPT_DOWNLOAD_URL, true)
    end)

    if not downloaded then
        warn("[NNVN HUB] Jnkie download failed: " .. tostring(source))
        return
    end

    if type(source) ~= "string" or #source < 100 then
        warn("[NNVN HUB] Jnkie returned an invalid response: " .. tostring(source))
        return
    end

    local mainChunk = compileSource(source, "@NNVN_HUB_MAIN")
    if not mainChunk then
        return
    end

    local executed, runtimeError = xpcall(mainChunk, function(errorMessage)
        return debug and debug.traceback and debug.traceback(tostring(errorMessage), 2)
            or tostring(errorMessage)
    end)

    if not executed then
        warn("[NNVN HUB] Main script runtime error: " .. tostring(runtimeError))
    end
end

local interfaceDownloaded, interfaceSource = pcall(function()
    return game:HttpGet("https://ophyn.space/interface", true)
end)

if not interfaceDownloaded then
    warn("[NNVN HUB] Ophyn download failed: " .. tostring(interfaceSource))
    return
end

local interfaceChunk = compileSource(interfaceSource, "@OPHYN_INTERFACE")
if not interfaceChunk then
    return
end

local interfaceLoaded, Ophyn = pcall(interfaceChunk)
if not interfaceLoaded or type(Ophyn) ~= "table" then
    warn("[NNVN HUB] Ophyn initialization failed: " .. tostring(Ophyn))
    return
end

