local JNKIE_SCRIPT_DOWNLOAD_URL = "--[[
    NNVN HUB - Ophyn UI Source for Jnkie

    Upload this file to the UI-Source field in your Jnkie Lua Script.
    Upload the actual NNVN HUB main script to the Original Code field.

    Before uploading, replace JNKIE_SCRIPT_DOWNLOAD_URL below with the
    public download URL generated for that Lua Script by Jnkie.
]]

local JNKIE_SCRIPT_DOWNLOAD_URL = "https://api.jnkie.com/api/v1/luascripts/public/65715a02f02d2e485e6f03b072080e1b68760de84457d777ae4d2405fda583d4/download"

local function loadProtectedMainScript(key)
    if type(key) ~= "string" or key == "" then
        warn("[NNVN HUB] Jnkie did not return a valid key.")
        return
    end

    if JNKIE_SCRIPT_DOWNLOAD_URL == ""
        or string.find(JNKIE_SCRIPT_DOWNLOAD_URL, "PASTE_YOUR_", 1, true) then
        warn("[NNVN HUB] Configure JNKIE_SCRIPT_DOWNLOAD_URL before uploading UI-Source.")
        return
    end

    -- Jnkie reads this value when the protected script download is requested.
    getgenv().SCRIPT_KEY = key

    local downloaded, source = pcall(function()
        return game:HttpGet(JNKIE_SCRIPT_DOWNLOAD_URL, true)
    end)

    if not downloaded or type(source) ~= "string" or #source < 100 then
        warn("[NNVN HUB] Failed to download Original Code: " .. tostring(source))
        return
    end

    local mainChunk, compileError = loadstring(source, "@NNVN_HUB_MAIN")
    if not mainChunk then
        warn("[NNVN HUB] Original Code compile error: " .. tostring(compileError))
        return
    end

    local executed, runtimeError = xpcall(mainChunk, function(errorMessage)
        return tostring(errorMessage)
    end)

    if not executed then
        warn("[NNVN HUB] Original Code runtime error: " .. tostring(runtimeError))
    end
end

